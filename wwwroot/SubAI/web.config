<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
     <remove name="aspNetCore" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="SubAI deny server files" stopProcessing="true">
          <match url="(^|/)(\.env([^/]*)?|config\.json|agent\.json|instructions\.md|package(-lock)?\.json|[^/]+\.(mjs|cjs|ps1)|shared|tests)(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="SubAI serve public assets directly" stopProcessing="true">
          <match url="^public/(chat\.css|chat\.js|hub\.js)$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="SubAI Node reverse proxy" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:5188/SubAI/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
